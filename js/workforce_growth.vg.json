{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/workforce_history_2020_2024.csv"
  },
  "transform": [
    {
      "filter": "datum.Profession === 'Total'"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Headcount",
      "type": "quantitative",
      "title": "Number of healthcare practitioners",
      "scale": {
        "zero": false,
        "padding": 20
      },
      "axis": {
        "format": ",d"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#367b83",
        "point": {
          "filled": true,
          "size": 90,
          "color": "#367b83"
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Headcount",
            "type": "quantitative",
            "title": "Practitioners",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020 || datum.Year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#233646"
      },
      "encoding": {
        "text": {
          "field": "Headcount",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
