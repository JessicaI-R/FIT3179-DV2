{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 550,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/JessicaI-R/FIT3179-DV2/main/data/workforce_history_2020_2024.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "datum.Profession === 'Total'"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "Headcount",
      "type": "quantitative",
      "title": "Number of healthcare practitioners",
      "scale": {"zero": false, "padding": 20},
      "axis": {"format": ",d"}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#367b83",
        "point": {
          "filled": true,
          "size": 90,
          "color": "#367b83"
        }
      },
      "encoding": {
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {
            "field": "Headcount",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020 || datum.Year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#32516a"
      },
      "encoding": {
        "text": {
          "field": "Headcount",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
