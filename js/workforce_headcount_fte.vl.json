{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive dumbbell chart comparing registered healthcare practitioner headcount and FTE in Australia, 2024.",
  "title": {
    "text": "Does Practitioner Headcount Reflect Workforce Capacity?",
    "subtitle": "Registered practitioners compared with full-time equivalent (FTE) workforce, 2024",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "offset": 18
  },
  "width": 750,
  "height": 540,
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/JessicaI-R/FIT3179-DV2/main/data/workforce_state_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "headcount": "number",
        "fte": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedView",
      "value": "All Professions",
      "bind": {
        "input": "select",
        "name": "View: ",
        "options": [
          "All Professions",
          "Smaller Professions"
        ]
      }
    },
    {
      "name": "selectedProfession",
      "value": "All Professions",
      "bind": {
        "input": "select",
        "name": "Highlight profession: ",
        "options": [
          "All Professions",
          "Nurses and Midwives",
          "Medical Practitioners",
          "Physiotherapists",
          "Psychologists",
          "Pharmacists",
          "Occupational Therapists",
          "Dental Practitioners",
          "Paramedicine Practitioners",
          "Medical Radiation Practitioners",
          "Optometrists",
          "Chiropractors",
          "Podiatrists",
          "Chinese Medicine Practitioners",
          "Osteopaths",
          "ATSI Health Practitioners"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.profession !== 'Total'"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "headcount",
          "as": "Headcount"
        },
        {
          "op": "sum",
          "field": "fte",
          "as": "FTE"
        }
      ],
      "groupby": ["profession"]
    },
    {
      "filter": "selectedView === 'All Professions' || (datum.profession !== 'Nurses and Midwives' && datum.profession !== 'Medical Practitioners')"
    },
    {
      "calculate": "datum.Headcount - datum.FTE",
      "as": "Difference"
    },
    {
      "calculate": "datum.FTE / datum.Headcount * 100",
      "as": "FTE_Percentage"
    },
    {
      "calculate": "selectedProfession === 'All Professions' || datum.profession === selectedProfession ? 1 : 0.15",
      "as": "HighlightOpacity"
    }
  ],
  "encoding": {
    "y": {
      "field": "profession",
      "type": "nominal",
      "sort": {
        "field": "Headcount",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 250,
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    },
    "opacity": {
      "field": "HighlightOpacity",
      "type": "quantitative",
      "scale": null,
      "legend": null
    },
    "tooltip": [
      {
        "field": "profession",
        "type": "nominal",
        "title": "Profession"
      },
      {
        "field": "Headcount",
        "type": "quantitative",
        "title": "Registered practitioners",
        "format": ",.0f"
      },
      {
        "field": "FTE",
        "type": "quantitative",
        "title": "Full-time equivalent",
        "format": ",.0f"
      },
      {
        "field": "Difference",
        "type": "quantitative",
        "title": "Headcount minus FTE",
        "format": "+,.0f"
      },
      {
        "field": "FTE_Percentage",
        "type": "quantitative",
        "title": "FTE as % of headcount",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#b5c3c9",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Headcount",
          "type": "quantitative",
          "title": "Number of Practitioners / FTE",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "format": "~s",
            "grid": true,
            "gridColor": "#e4ebee",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "x2": {
          "field": "FTE"
        }
      }
    },
    {
      "transform": [
        {
          "fold": ["Headcount", "FTE"],
          "as": ["Measure", "Value"]
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 145,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Value",
          "type": "quantitative"
        },
        "color": {
          "field": "Measure",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Headcount", "FTE"],
            "range": ["#247b85", "#e49b59"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 130,
            "labelFontSize": 12,
            "title": null
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "domainColor": "#b5c3c9",
      "tickColor": "#b5c3c9"
    }
  }
}
