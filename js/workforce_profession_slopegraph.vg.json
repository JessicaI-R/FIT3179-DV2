{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "https://raw.githubusercontent.com/JessicaI-R/FIT3179-DV2/main/data/workforce_history_2020_2024.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "filter": "datum.Year == 2020 || datum.Year == 2024"
    }
  ],

  "vconcat": [
    {
      "title": {
        "text": "Largest professions",
        "anchor": "start",
        "fontSize": 13
      },

      "width": 350,
      "height": 165,

      "transform": [
        {
          "filter": {
            "field": "Profession",
            "oneOf": [
              "Nurses and Midwives",
              "Medical Practitioners"
            ]
          }
        }
      ],

      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 80
        }
      },

      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": [2020, 2024],
          "scale": {
            "paddingInner": 0.2,
            "paddingOuter": 0.18
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontWeight": "bold",
            "labelFontSize": 12,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "Headcount",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "axis": {
            "title": "Practitioners",
            "format": "~s",
            "tickCount": 4
          }
        },

        "color": {
          "field": "Profession",
          "type": "nominal",
          "scale": {
            "domain": [
              "Nurses and Midwives",
              "Medical Practitioners"
            ],
            "range": [
              "#367b83",
              "#b48b55"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "columns": 1,
            "labelFontSize": 10,
            "symbolSize": 70
          }
        },

        "detail": {
          "field": "Profession"
        },

        "tooltip": [
          {
            "field": "Profession",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "Headcount",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },

    {
      "title": {
        "text": "Other selected professions",
        "anchor": "start",
        "fontSize": 13
      },

      "width": 350,
      "height": 225,

      "transform": [
        {
          "filter": {
            "field": "Profession",
            "oneOf": [
              "Physiotherapists",
              "Psychologists",
              "Pharmacists",
              "Occupational Therapists",
              "Dental Practitioners",
              "Paramedicine Practitioners"
            ]
          }
        }
      ],

      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 80
        }
      },

      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": [2020, 2024],
          "scale": {
            "paddingInner": 0.2,
            "paddingOuter": 0.18
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontWeight": "bold",
            "labelFontSize": 12,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "Headcount",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "axis": {
            "title": "Practitioners",
            "format": "~s",
            "tickCount": 4
          }
        },

        "color": {
          "field": "Profession",
          "type": "nominal",
          "scale": {
            "domain": [
              "Physiotherapists",
              "Psychologists",
              "Pharmacists",
              "Occupational Therapists",
              "Dental Practitioners",
              "Paramedicine Practitioners"
            ],
            "range": [
              "#9675ad",
              "#d27d80",
              "#d49a43",
              "#679c91",
              "#6d8ba6",
              "#789c79"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "columns": 1,
            "labelFontSize": 10,
            "symbolSize": 70
          }
        },

        "detail": {
          "field": "Profession"
        },

        "tooltip": [
          {
            "field": "Profession",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "Headcount",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "y": "independent",
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e5e9eb"
    },
    "concat": {
      "spacing": 15
    }
  }
}
