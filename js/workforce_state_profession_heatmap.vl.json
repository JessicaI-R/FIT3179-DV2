{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive heatmap of Australia's registered healthcare workforce by state and profession, 2024.",
  "title": {
    "text": "How Does the Healthcare Workforce Differ Across Australia?",
    "subtitle": "Registered healthcare practitioners by profession and state, 2024",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 18
  },
  "width": 650,
  "height": 500,
  "background": "white",

  "data": {
    "url": "https://raw.githubusercontent.com/JessicaI-R/FIT3179-DV2/main/data/workforce_state_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "headcount": "number"
      }
    }
  },

  "params": [
    {
      "name": "viewMode",
      "value": "Headcount",
      "bind": {
        "input": "select",
        "options": [
          "Headcount",
          "Percentage"
        ],
        "labels": [
          "Practitioner headcount",
          "Share of state's workforce (%)"
        ],
        "name": "Compare by: "
      }
    },
    {
      "name": "selectedProfession",
      "value": "All professions",
      "bind": {
        "input": "select",
        "options": [
          "All professions",
          "Nurses and Midwives",
          "Medical Practitioners",
          "Physiotherapists",
          "Psychologists",
          "Pharmacists",
          "Occupational Therapists",
          "Dental Practitioners",
          "Paramedicine Practitioners",
          "Medical Radiation Practitioners",
          "Optometrists",
          "Chiropractors",
          "Podiatrists",
          "Chinese Medicine Practitioners",
          "Osteopaths",
          "ATSI Health Practitioners"
        ],
        "name": "Highlight profession: "
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.profession !== 'Total'"
    },
    {
      "filter": {
        "field": "state",
        "oneOf": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ]
      }
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "headcount",
          "as": "stateTotal"
        }
      ],
      "groupby": ["state"]
    },
    {
      "calculate": "datum.stateTotal > 0 ? datum.headcount / datum.stateTotal * 100 : null",
      "as": "percentage"
    },
    {
      "calculate": "viewMode === 'Headcount' ? datum.headcount : datum.percentage",
      "as": "displayValue"
    },
    {
      "calculate": "datum.state === 'New South Wales' ? 'NSW' : datum.state === 'Victoria' ? 'VIC' : datum.state === 'Queensland' ? 'QLD' : datum.state === 'Western Australia' ? 'WA' : datum.state === 'South Australia' ? 'SA' : datum.state === 'Tasmania' ? 'TAS' : datum.state === 'Northern Territory' ? 'NT' : 'ACT'",
      "as": "stateAbbr"
    },
    {
      "calculate": "selectedProfession === 'All professions' || datum.profession === selectedProfession",
      "as": "isHighlighted"
    },
    {
      "calculate": "isValid(datum.displayValue) ? 'Available' : 'Missing'",
      "as": "dataStatus"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "stateAbbr",
          "type": "ordinal",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "WA",
            "SA",
            "TAS",
            "NT",
            "ACT"
          ],
          "title": "State / Territory",
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "titleFontSize": 12,
            "labelPadding": 10
          }
        },
        "y": {
          "field": "profession",
          "type": "nominal",
          "sort": {
            "field": "headcount",
            "op": "sum",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 240,
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.displayValue)"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "stateAbbr",
          "type": "ordinal",
          "sort": [
            "NSW",
            "VIC",
            "QLD",
            "WA",
            "SA",
            "TAS",
            "NT",
            "ACT"
          ],
          "title": "State / Territory",
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "titleFontSize": 12,
            "labelPadding": 10
          }
        },
        "y": {
          "field": "profession",
          "type": "nominal",
          "sort": {
            "field": "headcount",
            "op": "sum",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 240,
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "displayValue",
          "type": "quantitative",
          "title": "Headcount / Workforce share (%)",
          "scale": {
            "scheme": "tealblues",
            "zero": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 280,
            "gradientThickness": 12,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "format": ",.0f"
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.isHighlighted",
            "value": 1
          },
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "profession",
            "type": "nominal",
            "title": "Profession"
          },
          {
            "field": "headcount",
            "type": "quantitative",
            "title": "Registered practitioners",
            "format": ",.0f"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Share of state's workforce (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false
    },
    "font": "Arial"
  }
}
